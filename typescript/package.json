{
  "name": "@agentfirst-f1/typescript",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "baseline": "bash ../scripts/baseline.sh --include-api-hash",
    "baseline:no-tests": "bash ../scripts/baseline.sh --no-tests --include-api-hash",
    "baseline:diff": "bash ../scripts/diff-baseline.sh"
  },
  "dependencies": {
    "@tencent-ai/agent-sdk": "^0.3.161",
    "commander": "^14.0.0",
    "pino": "^9.7.0",
    "yaml": "^2.8.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
